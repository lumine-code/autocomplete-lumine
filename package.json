{
  "name": "autocomplete-lumine",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Autocompletions for the Lumine API.",
  "keywords": [
    "api",
    "completion",
    "suggestion",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/autocomplete-lumine",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-lumine/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "completions.json",
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "node ./update/update.js"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#6c6a5887bd452ab659ab1b5b9923b570cb83ef32",
    "babylon": "^6.18.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "joanna": "^0.0.11",
    "prettier": "^3.9.6",
    "tello": "^1.2.0"
  }
}
