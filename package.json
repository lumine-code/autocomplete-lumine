{
  "name": "autocomplete-lumine",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Autocompletions for the Lumine API.",
  "keywords": [
    "api",
    "completion",
    "suggestion",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/autocomplete-lumine",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-lumine/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "completions.json",
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "test:update": "node --test update/update.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "node ./update/update.js",
    "update:check": "node ./update/update.js --check"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#ef0edb8764a963d1bc4103ec7038543309e544e4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
