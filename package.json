{
  "name": "autocomplete-lumine",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Autocompletions for the Lumine API.",
  "keywords": [
    "api",
    "completion",
    "suggestion",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/autocomplete-lumine",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-lumine/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "completions.json",
    "lib",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "test:update": "node --test update/update.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "node ./update/update.js",
    "update:check": "node ./update/update.js --check"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#afd7bf8fb58cdc33a5bdb93c4965be876045dbec",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
