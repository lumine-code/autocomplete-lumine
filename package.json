    "update": "node ./update/update.js"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "https://github.com/lumine-code/node-temp.git#929dfd04196566b21baef93fddc24a19db329bd0",
    "babylon": "^6.18.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "joanna": "^0.0.11",
    "prettier": "^3.9.6",
    "tello": "^1.2.0"
  }
}
