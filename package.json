{
  "name": "autocomplete-lumine",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Autocompletions for the Lumine API.",
  "keywords": [
    "api",
    "completion",
    "suggestion",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/autocomplete-lumine",
  "bugs": {
    "url": "https://github.com/lumine-code/autocomplete-lumine/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "completions.json",
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "test:update": "node --test update/update.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "node ./update/update.js",
    "update:check": "node ./update/update.js --check"
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#2b4bd6242c342e98f4302a546cfc87b158c2c177",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
